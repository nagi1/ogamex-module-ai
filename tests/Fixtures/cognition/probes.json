{
    "_meta": {
        "purpose": "Answers the cognition sidecars cannot give, because they are contract violations, values the authored scenario cannot reach, or bodies past the module's own read bound. Everything the drivers really do send lives in fatima.json, cbrkit.json and agentos.json, captured by scripts/capture-cognition-fixtures.php. Nothing here is captured: a driver that violated its contract could not be asked to reproduce it.",
        "authored_by": "hand",
        "consumer": "Modules\\AI\\Tests\\Support\\InteractsWithCognitionFixtures::driverProbe()",
        "tokens": "A body value or key written as @name is replaced by the value the test supplies, which is how a probe refers to a record of the request it answers: a duplicate id has to be one the request carried, or it would be refused for being unknown instead."
    },
    "channels": {
        "fatima.emotions.plain_failure": {
            "note": "FAtiMA serialises a failure as a plain JSON string while still answering HTTP 200, so a status code carries no meaning on this sidecar.",
            "body": "There are already stored property values that will collide"
        },
        "fatima.server_error": {
            "note": "FAtiMA answers HTTP 200 even for its own failures, so a non-success status is a transport-level failure rather than a driver answer.",
            "status": 500,
            "body": "boom"
        },
        "fatima.emotions.missing_pool": {
            "note": "A truncated payload: the driver omitted the Emotions key entirely.",
            "body": {
                "Name": "Miner",
                "Mood": 0
            }
        },
        "fatima.emotions.non_object_pool": {
            "note": "A pool that is a string rather than a list.",
            "body": {
                "Name": "Miner",
                "Mood": 0,
                "Emotions": "none"
            }
        },
        "fatima.emotions.malformed_entry": {
            "note": "An entry whose intensity is not numeric. The authored scenario always evaluates its appraisal variables, so it cannot emit this.",
            "body": {
                "Name": "Miner",
                "Mood": 0,
                "Emotions": [
                    {
                        "Type": "Anger",
                        "Intensity": "high",
                        "CauseEventName": "Event(Action-End, Other, Harm, Miner)"
                    }
                ]
            }
        },
        "fatima.emotions.missing_cause": {
            "note": "An entry without a cause event, so the module cannot tell whether it belongs to the stimulus it just sent.",
            "body": {
                "Name": "Miner",
                "Mood": 0,
                "Emotions": [
                    {
                        "Type": "Anger",
                        "Intensity": 1
                    }
                ]
            }
        },
        "fatima.emotions.unrepresentable": {
            "note": "An OCC emotion outside the module's three. The authored rules bind desirability and praiseworthiness, which is why the driver answers Gratitude or Anger rather than Joy for these events.",
            "body": {
                "Name": "Miner",
                "Mood": 0,
                "Emotions": [
                    {
                        "Type": "Joy",
                        "Intensity": 0.9,
                        "Target": "-",
                        "CauseEventId": 1,
                        "CauseEventName": "Event(Action-End, Other, Aid, Miner)"
                    }
                ]
            }
        },
        "fatima.emotions.wrong_cause": {
            "note": "An emotion pool left over from a different event. The driver is re-seeded before every appraisal, so it does not answer with a stale cause.",
            "body": {
                "Name": "Miner",
                "Mood": 0,
                "Emotions": [
                    {
                        "Type": "Anger",
                        "Intensity": 0.9,
                        "Target": "Other",
                        "CauseEventId": 1,
                        "CauseEventName": "Event(Action-End, Other, Harm, Miner)"
                    }
                ]
            }
        },
        "fatima.emotions.beyond_scale": {
            "note": "An intensity above the module's 0..1 scale, for the driver-swap authority probe. The authored rules echo the belief they are given, and the module's own stimuli stay inside the scale, so this needs a belief the module never writes.",
            "body": {
                "Name": "Miner",
                "Mood": 0,
                "Emotions": [
                    {
                        "Type": "Anger",
                        "Intensity": 5,
                        "Target": "Other",
                        "CauseEventId": 1,
                        "CauseEventName": "Event(Action-End, Other, Harm, Miner)"
                    }
                ]
            }
        },
        "fatima.emotions.oversized": {
            "note": "A body past the module's own read bound; the real pool for one appraisal is a few hundred bytes.",
            "body": ""
        },
        "fatima.socialexchanges.none": {
            "note": "An empty exchange set, which the driver returns when the scenario authors no exchange for the target.",
            "body": []
        },
        "fatima.socialexchanges.other": {
            "note": "A different authored exchange than the one the module reads.",
            "body": [
                {
                    "Name": "SomethingElse",
                    "Step": "Start",
                    "Volitions": []
                }
            ]
        },
        "fatima.socialexchanges.non_list": {
            "note": "The endpoint answers a JSON object rather than a list when it cannot resolve the scenario, instance or character.",
            "body": {
                "Message": "The given key was not present in the dictionary."
            }
        },
        "fatima.socialexchanges.malformed_entry": {
            "note": "A non-list payload where the module cannot map a name, step and volition set.",
            "body": [
                {
                    "Name": "CooperativeMove",
                    "Step": "Start"
                }
            ]
        },
        "fatima.socialexchanges.non_numeric_volition": {
            "note": "A volition the module cannot read as a number.",
            "body": [
                {
                    "Name": "CooperativeMove",
                    "Step": "Start",
                    "Volitions": {
                        "*": "many"
                    }
                }
            ]
        },
        "fatima.socialexchanges.lukewarm": {
            "note": "A non-empty volition below the module's own acceptance threshold. The authored influence rule sets a constant, so the driver answers 7 or nothing at all and cannot reach this value.",
            "body": [
                {
                    "Name": "CooperativeMove",
                    "Step": "Start",
                    "Volitions": {
                        "*": 2
                    }
                }
            ]
        },
        "cbrkit.server_error": {
            "note": "A transport-level failure, reproducible only by taking the sidecar down.",
            "status": 500,
            "body": "boom"
        },
        "cbrkit.malformed_payload": {
            "note": "A 200 whose body has no retrieval step; the retriever always answers with one.",
            "body": {
                "unexpected": true
            }
        },
        "cbrkit.non_object_payload": {
            "note": "A 200 whose body is not JSON at all.",
            "body": "ok"
        },
        "cbrkit.omits_a_sent_case": {
            "note": "A retrieval step that scores no case the module sent. The retriever scores every case it is handed, so a missing score can only be authored.",
            "body": {
                "steps": [
                    {
                        "queries": {
                            "current": {
                                "similarities": {
                                    "999999": 0.9
                                }
                            }
                        }
                    }
                ]
            }
        },
        "cbrkit.oversized": {
            "note": "A body past the module's own read bound.",
            "body": ""
        },
        "agentos.not_json": {
            "note": "A 200 whose body is not JSON.",
            "body": "not json"
        },
        "agentos.no_ranking_key": {
            "note": "A 200 with no ranking key; the driver always answers with one.",
            "body": {
                "considered": 1
            }
        },
        "agentos.entry_not_object": {
            "note": "A ranking entry that is not an object.",
            "body": {
                "ranking": [
                    5
                ]
            }
        },
        "agentos.id_not_integer": {
            "note": "A ranking entry whose id is a string.",
            "body": {
                "ranking": [
                    {
                        "id": "11"
                    }
                ]
            }
        },
        "agentos.server_error": {
            "note": "A transport-level failure, reproducible only by taking the sidecar down.",
            "status": 500,
            "body": {
                "ranking": [
                    {
                        "id": 1
                    }
                ]
            }
        },
        "agentos.empty_ranking": {
            "note": "No relevant memory found. The driver answers a query with no lexical overlap by returning every candidate in the order it was given, so it never returns an empty ranking for a non-empty candidate set.",
            "body": {
                "ranking": []
            }
        },
        "agentos.unsent_id": {
            "note": "A ranking naming an id the module never sent. The driver only ever reorders the candidates it was handed.",
            "body": {
                "ranking": [
                    {
                        "id": 999999
                    }
                ]
            }
        },
        "agentos.repeated_id": {
            "note": "A ranking naming the same memory twice. The id is one of the request's own candidates, supplied by the test, because a repeated unsent id would be refused for being unsent instead.",
            "body": {
                "ranking": [
                    {
                        "id": "@candidate"
                    },
                    {
                        "id": "@candidate"
                    }
                ]
            }
        },
        "agentos.oversized": {
            "note": "A body past the module's own read bound.",
            "body": ""
        },
        "cbrkit.scores_an_unsent_case": {
            "note": "A retrieval step that scores a case the module never sent alongside one it did. The retriever scores only what it is handed, so the extra id can only be authored; the sent id is supplied by the test.",
            "body": {
                "steps": [
                    {
                        "queries": {
                            "current": {
                                "similarities": {
                                    "@sent": 1.0,
                                    "987654": 1.0
                                }
                            }
                        }
                    }
                ]
            }
        },
        "agentos.reversed_pair": {
            "note": "A ranking that reverses the two candidates the request sent. The order is what an authority test needs to prove the driver reordered nothing but the answer, and the ids are the request's own.",
            "body": {
                "ranking": [
                    {
                        "id": "@second"
                    },
                    {
                        "id": "@first"
                    }
                ]
            }
        }
    }
}
