#!/usr/bin/env bash
#
# The AI module's task runner: one short command for every module task, run from the
# module checkout. Commands execute on the host by default; OGAMEX_RUNNER=local-docker-dev
# runs them inside the application container instead.
set -euo pipefail

MODULE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OGAMEX_ROOT="${OGAMEX_ROOT:-$(cd "$MODULE_ROOT/../.." 2>/dev/null && pwd || true)}"

if [ -z "$OGAMEX_ROOT" ] || [ ! -f "$OGAMEX_ROOT/artisan" ]; then
    echo "OGameX root not found. Set OGAMEX_ROOT to the OGameX checkout." >&2

    exit 1
fi

run_core() {
    # A command that must not share a database with the running application passes one through
    # AI_DB_OVERRIDE; every other command uses the container's own configuration.
    db_pair=()
    db_flag=()
    if [ -n "${AI_DB_OVERRIDE:-}" ]; then
        db_pair=("DB_DATABASE=${AI_DB_OVERRIDE}")
        db_flag=(-e "DB_DATABASE=${AI_DB_OVERRIDE}")
    fi

    case "${OGAMEX_RUNNER:-host}" in
        host)
            (cd "$OGAMEX_ROOT" && env "${db_pair[@]}" "$@")
            ;;
        local-docker-dev)
            # PAO formats output for an agent and decides that from the environment. The
            # editor sets an agent marker in this shell, but `docker compose exec` starts the
            # container with the service environment only, so the marker has to be passed
            # through explicitly; the PAO switches ride along for the operator.
            pao_env=()
            for name in AI_AGENT PAO_FORCE PAO_DISABLE; do
                if [ -n "${!name:-}" ]; then
                    pao_env+=(-e "$name=${!name}")
                fi
            done

            # local-docker-dev already runs the application, so commands execute in that
            # container instead of a one-off container from the default stack.
            (cd "$OGAMEX_ROOT/local-docker-dev" && docker compose exec -T "${pao_env[@]}" "${db_flag[@]}" ogamex-app "$@")
            ;;
        *)
            echo "Unknown OGAMEX_RUNNER '${OGAMEX_RUNNER}'. Use 'host' or 'local-docker-dev'." >&2

            exit 1
            ;;
    esac
}

# Tests always run in parallel: every worker owns its database clone and its compiled
# caches, so bailing early costs nothing while a serial run wastes the session.
#
# The worker count is pinned rather than auto-detected. Laravel keys each clone
# database off the worker token, so an auto-detected count on a many-core host creates
# one full schema per core: dozens of databases, a persistent connection per clone, and
# schema DDL that blocks behind those idle connections. A bounded count keeps the clone
# set small and lets the same clones be reused across runs instead of accumulating.
pest_flags() {
    printf '%s' "--parallel --bail --processes=${PARALLEL_PROCESSES:-4}"
}

# The timeout runs *inside* the container, not around the `docker compose exec` client.
#
# A docker exec client does not forward a signal to the process it started, so timing the
# client out or cancelling it leaves the test workers running: they keep their database
# transactions and row locks, and every later run then fails on a one second lock wait
# timeout. Bounding the run where the workers actually live means a run cannot outlive its
# own budget. Hitting this cap means a hang, not slowness.
pest_runner() {
    printf 'timeout -k 5 %s ./vendor/bin/pest' "${TEST_TIMEOUT:-120}"
}

# Clears locks left behind by an earlier killed run before starting a new one, so a stale
# session is self-healing instead of a manual database rescue.
reap_stale_test_sessions() {
    run_core php Modules/AI/scripts/reap-test-sessions.php
}

# The database the serial gate owns, created on first use and kept current afterwards.
#
# The gate is the one run that cannot have Laravel's per-worker database clones, and its test cases
# roll back instead of starting from a fresh schema. Any row another process committed while it runs
# is therefore visible to it: a pilot account finishing a building in the same database is enough to
# fail a test that counts rows, and a failing gate then looks like a code defect that is not there.
# Sharing a database with the running application is not a test environment, so the gate takes one
# of its own and no longer depends on what else is running. The name has to read as a test database:
# the stale-session reaper only ever touches one of those.
COVERAGE_DATABASE="${AI_COVERAGE_DATABASE:-ogamex-test-ai-coverage}"

prepare_coverage_database() {
    prepare_coverage_database_for "$COVERAGE_DATABASE"
}

prepare_coverage_database_for() {
    local AI_DB_OVERRIDE="$1"
    # Creating the database needs a connection without one selected, so it is done with a raw
    # client rather than through the application, which could not connect to a missing database.
    run_core php -r '
$pdo = new PDO(
    sprintf("mysql:host=%s;port=%s", getenv("DB_HOST"), getenv("DB_PORT") ?: "3306"),
    (string) getenv("DB_USERNAME"),
    (string) getenv("DB_PASSWORD"),
);
$pdo->exec(sprintf(
    "CREATE DATABASE IF NOT EXISTS `%s` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci",
    getenv("DB_DATABASE"),
));
'
    run_core php artisan migrate --force --no-interaction
}

usage() {
    cat <<'TEXT'
Usage: bash scripts/ogamex <command> [args...]

Lifecycle (host commands; the module never reimplements them):
  install [--dry-run]                   verify, migrate, run the install hook, enable, refresh
  uninstall [--drop-data] [--dry-run]   uninstall hook, optional data drop, disable, refresh
  doctor                                read-only queue/container/Redis wiring report
  enable | disable                      raw status-file toggles only
  e2e-lifecycle                         live host trial: absent, install, pickup, uninstall

Checks:
  artisan <args...>                     run any artisan command in the host
  test                                  Pest for this module, parallel with --bail
  test-all                              the whole OGameX suite, parallel with --bail
  quality                               Gate 2 review, Rector, Pint, PHPStan, then this module's tests
  gate                                  the over-engineering gate (Gate 2), deterministic half
  coverage                              the one serial run: PCOV coverage of Modules/AI/app
  reap                                  release locks left by a killed test run

Proof (a task is done when its proof passes; see .github/skills/ai-task-execute):
  scorecard [--hours=N] [--aspect=X] [--save=CODE] [--compare=FILE]
                                        every aspect of a real player's day, PASS/FAIL, on a cohort
  situation <name|all|list>             plant a situation on a cohort, drive it, read the answer back
  prove <CODE> [--json]                 test steps first (stops at a red one), then live steps; PROOF: PASS|FAIL
                                        names the failing step; --json ends stdout with one JSON verdict line
  test-one <TestName>                   one module test file by name (fast, no parallel start-up)
  economy <player_id>                   per planet: building, what it would queue, or the gate that refuses it
  stories                               every Situation-kit story, PASS/FAIL with the kit's diagnosis (~5 s)

Live (on a cohort, PROVE_UNIVERSE=grand by default; all read-only except situation):
  pulse [minutes]                       what the cohort did in the last N minutes, refusals, worker backlog
  account <player_id> [minutes]         one account: planets, queues, fleets, recent work, refusals, decisions
  why <player_id>                       what its next session will see: published actions, every input flag,
                                        the real decision over it and what the candidate factory turned down

Environment:
  OGAMEX_ROOT          OGameX checkout (default: two levels above this script)
  OGAMEX_RUNNER        host (default) or local-docker-dev
  PARALLEL_PROCESSES   pin the number of test workers
  TEST_TIMEOUT         seconds before a test run is killed in-container (default: 120)
  COVERAGE_TIMEOUT     seconds before the serial coverage run is killed (default: 600)
  AI_COVERAGE_DATABASE database the serial coverage gate owns (default: ogamex-test-ai-coverage)
  PROVE_UNIVERSE       cohort the proof reads: grand (default) or pve
  PROVE_HOURS          scorecard window an aspect step is judged on (default: 2)
TEXT
}

# One lane for every run on the shared test database. The harness takes the same lock file
# (strategy-pipeline.py, key "verify:shared-test-database"), so an agent's test and a harness
# verification never run together: two suites on one database fail each other, and each retry then
# chases an error the other caused.
with_test_lane() {
    # The harness passes this when the calling attempt already holds the lane for its whole verdict.
    if [ "${OGAMEX_LANE_HELD:-}" = 1 ]; then
        # The harness holds lane 1's lock for a whole verdict; the run itself goes to a database of
        # its own, never the one the scheduler and queue worker write to.
        local rc=0 had_override="${AI_DB_OVERRIDE:-}"
        if [ -z "$had_override" ]; then
            export AI_DB_OVERRIDE="ogamex-test-harness"
            prepare_lane_database
        fi
        "$@" || rc=$?
        [ -n "$had_override" ] || unset AI_DB_OVERRIDE
        return $rc
    fi
    # Lane 1 is the harness's lock and the shared test database. Lanes 2..N are the same tests on a
    # database of their own (ogamex-test-laneN, migrated once), so a proof run no longer waits behind
    # whoever holds lane 1: the wait was most of a 40 s test step.
    local claims="$MODULE_ROOT/plan/research/ogame/claims" lock lane key rc=0 told=0 held="" had_override="${AI_DB_OVERRIDE:-}"
    mkdir -p "$claims"
    while [ -z "$held" ]; do
        # Lane 1 is the database the running scheduler and queue worker write to, so a suite there reads
        # their rows as its own; the lanes start at 2 and the lane count is how many private databases run.
        for lane in $(seq 2 $(( ${OGAMEX_LANES:-4} + 1 ))); do
            key='verify:shared-test-database'
            [ "$lane" = 1 ] || key="verify:test-lane-$lane"
            lock="$claims/$(printf '%s' "$key" | sha256sum | cut -c1-16).lock"
            # A run killed mid-test leaves its lock; the harness ages its own out after 30 minutes too.
            if [ -e "$lock" ] && [ $(( $(date +%s) - $(stat -c %Y "$lock" 2>/dev/null || date +%s) )) -gt 1800 ]; then
                rm -f "$lock"
            fi
            if (set -o noclobber; printf '%s\npid %s at %s UTC (ogamex)\n' "$key" "$$" "$(date -u '+%F %T')" > "$lock") 2>/dev/null; then
                held="$lock"
                break
            fi
        done
        [ -n "$held" ] && break
        [ "$told" = 1 ] || echo "waiting for a test lane (all ${OGAMEX_LANES:-4} held)" >&2
        told=1
        sleep 1
    done
    trap 'rm -f "$held"' INT TERM
    if [ -z "${AI_DB_OVERRIDE:-}" ]; then
        export AI_DB_OVERRIDE="ogamex-test-lane$lane"
        prepare_lane_database
    fi
    "$@" || rc=$?
    rm -f "$held"
    trap - INT TERM
    [ "$had_override" != "" ] || unset AI_DB_OVERRIDE
    return $rc
}

# A lane database is created and migrated the first time its lane runs.
prepare_lane_database() {
    [ -e "/tmp/ogamex-lane-ready-$AI_DB_OVERRIDE" ] && return
    prepare_coverage_database_for "$AI_DB_OVERRIDE" && : > "/tmp/ogamex-lane-ready-$AI_DB_OVERRIDE"
}

# The cohorts are their own stacks (grand, pve); the dev stack holds no AI population, so a
# situation or a scorecard read there says nothing about how the accounts play.
in_universe() {
    local universe="$1"
    shift
    (cd "$OGAMEX_ROOT/local-docker-dev" && docker compose -f "docker-compose.${universe}.yml" exec -T ogamex-app \
        sh -lc "cd /var/www && $(printf '%q ' "$@")")
}

# What a step printed, without the colour codes pest and artisan add.
strip_ansi() {
    sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$1"
}

# The one line that says why a step failed: pest's first FAILED line and the message under it, the
# situation's read-back, the invariant's first [NAME] row, the aspect's count against its floor. A step
# that printed none of those is described by the last thing it said.
step_line() {
    local kind="$1" name="$2" file="$3" line=""
    case "$kind" in
        test) line="$(strip_ansi "$file" | grep -m1 -A1 'FAILED' | tr '\n' ' ' || true)" ;;
        situation) line="$(strip_ansi "$file" | grep -m1 'read-back' || true)" ;;
        invariant) line="$(strip_ansi "$file" | grep -m1 "\[$name\]" || true)" ;;
        aspect) line="$(strip_ansi "$file" | grep -m1 -E "^ +(FAIL|PASS) +$name " || true)" ;;
    esac
    [ -n "$line" ] || line="$(strip_ansi "$file" | grep -v '^[[:space:]]*$' | tail -n1 || true)"
    printf '%s' "${line:-no output}" | tr -s ' \t' ' ' | cut -c1-300
}

# Test steps first, stopping at the first one that fails: a red test makes the live steps meaningless
# and they cost minutes on a cohort. The live steps run, all of them, only when every test passed, so
# one run still shows everything that is wrong on the cohort. `--json` keeps stdout for the verdict
# alone (progress goes to stderr) and ends it with one JSON line; proofs/CODE.log is rewritten per run.
prove_row() {
    local code="$1" as_json=0 steps ordered step kind name suspect started rc out results hours age
    local progress=1 tests_failed=0
    [ "${2:-}" = "--json" ] && { as_json=1; progress=2; }
    steps="$(python3 "$MODULE_ROOT/plan/tasks/task.py" proof "$code")"
    if [ -z "$steps" ]; then
        echo "PROOF: FAIL $code states no proof (task.py proof $code test:X situation:Y aspect:Z invariant:NAME)" >&"$progress"
        [ "$as_json" = 0 ] || printf '{"code":"%s","pass":false,"steps":[]}\n' "$code"
        return 1
    fi
    mkdir -p "$MODULE_ROOT/plan/research/ogame/proofs"
    out="$(mktemp)"
    results="$(mktemp)"
    # An aspect is judged only on play since the change landed: a window that reaches back before it
    # measures the old code and can pass for the wrong reason. The writer's marker dates the change;
    # a change made by hand uses PROVE_HOURS.
    local marker="$MODULE_ROOT/plan/research/ogame/implemented/$code.md"
    hours="${PROVE_HOURS:-2}"
    age=$(( hours * 3600 ))
    if [ -f "$marker" ]; then
        age=$(( $(date +%s) - $(stat -c %Y "$marker") ))
        hours=$(( age / 3600 ))
        [ "$hours" -gt 24 ] && hours=24
    fi
    # PROVE_FAST=1 runs only the test steps: a verdict in seconds, for the writer's own attempts. The live
    # steps (a situation on the cohort, an invariant, an aspect) judge a delivered row later.
    ordered="$(for step in $steps; do case "$step" in test:*) echo "$step" ;; esac; done
               [ "${PROVE_FAST:-0}" = 1 ] || for step in $steps; do case "$step" in test:*) ;; *) echo "$step" ;; esac; done)"
    for step in $ordered; do
        # A trailing ? marks a step suspect: it is reported but never fails the row.
        suspect=0
        case "$step" in *\?) suspect=1; step="${step%?}" ;; esac
        kind="${step%%:*}"
        name="${step#*:}"
        [ "$kind" = test ] || [ "$tests_failed" = 0 ] || break
        echo "--- $step" >&"$progress"
        started=$(date +%s)
        rc=0
        : > "$out"
        case "$kind" in
            test) with_test_lane run_core ./vendor/bin/pest --testsuite=Modules --filter="$name" 2>&1 | tee "$out" >&"$progress" || rc=1 ;;
            situation)
                # A situation has a Situation-kit story that plays it in about a second on the test database;
                # the live run waits for real workers and took 183 s. The kit story is the proof, the live
                # run is the fallback for a situation no story covers yet.
                story="$(printf '%s' "$name" | sed -E 's/(^|-)([a-z])/\U\2/g')SituationTest"
                if [ -f "$MODULE_ROOT/tests/Feature/Situations/$story.php" ]; then
                    with_test_lane run_core ./vendor/bin/pest --testsuite=Modules --filter="$story" 2>&1 | tee "$out" >&"$progress" || rc=1
                else
                    in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/cohort-scenario.php run "$name" --confirm --cleanup 2>&1 | tee "$out" >&"$progress" || rc=1
                fi
                ;;
            invariant)
                # verify-cohorts names a violated invariant as "[NAME]"; its absence is the pass, but
                # only when the read itself ran (it ends with a QUALITY line).
                in_universe "${PROVE_UNIVERSE:-grand}" php artisan tinker --execute="require '/var/www/Modules/AI/scripts/verify-cohorts.php';" 2>&1 | tee "$out" >&"$progress" || true
                if grep -q "\[$name\]" "$out" || ! grep -q 'QUALITY:' "$out"; then
                    rc=1
                fi
                ;;
            aspect)
                if [ "$hours" -lt 1 ]; then
                    # Under an hour a pass is still evidence (the floor scales with the window and never
                    # drops below one event); only a fail has to wait for the full hour to mean anything.
                    early="$(awk -v s="$age" 'BEGIN { h = s / 3600; printf "%.2f", (h < 0.1 ? 0.1 : h) }')"
                    if in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/play-scorecard.php --aspect="$name" --hours="$early" > "$out" 2>&1; then
                        echo "early pass: the aspect already passes on the ${early}h since this change" >> "$out"
                        cat "$out" >&"$progress"
                    else
                        echo "too early: the cohort has played under an hour on this change (not yet passing on ${early}h)" | tee "$out" >&"$progress"
                        rc=1
                    fi
                else
                    in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/play-scorecard.php --aspect="$name" --hours="$hours" --save="$code" 2>&1 | tee "$out" >&"$progress" || rc=1
                fi
                ;;
            harness) python3 "$MODULE_ROOT/scripts/strategy-pipeline.py" --self-check 2>&1 | tee "$out" >&"$progress" || rc=1 ;;
            *) echo "unknown proof step $step" > "$out"; rc=1 ;;
        esac
        [ "$rc" = 0 ] || [ "$kind" != test ] || tests_failed=1
        took=$(( $(date +%s) - started ))
        # A verification step has a minute. The babysitter reads this file and builds the missing fast path.
        [ "$took" -le "${PROVE_STEP_BUDGET:-60}" ] || printf '%s\t%s\t%s\t%s\n' "$(date -u '+%F %T')" "$code" "$step" "$took" >> "$MODULE_ROOT/plan/research/ogame/slow-steps.log"
        printf '%s\t%s\t%s\t%s\t%s\n' "$step" "$rc" "$took" "$suspect" "$(step_line "$kind" "$name" "$out")" >> "$results"
    done
    local verdict_rc=0
    python3 - "$code" "$results" "$as_json" "$MODULE_ROOT/plan/research/ogame/proofs/$code.log" "$steps" <<'PY' || verdict_rc=$?
import json, sys

code, results, as_json, log, steps = sys.argv[1:6]
rows = []
for raw in open(results).read().splitlines():
    step, rc, seconds, suspect, line = (raw.split("\t") + [""] * 5)[:5]
    rows.append({"step": step, "pass": rc == "0", "seconds": int(seconds), "suspect": suspect == "1", "line": line})

# A suspect step is reported but never fails the row.
failing = [row for row in rows if not row["pass"] and not row["suspect"]]
# Every failing step only waiting out the hour a live aspect needs is not a failure: it must not read as one
# (156 PROOF: FAIL lines in a night, 96 of them "too early", made the progress look like wreckage).
waiting = bool(failing) and all("too early" in row["line"] for row in failing)
verdict = f"PROOF: {'WAIT' if waiting else 'FAIL' if failing else 'PASS'} {code} ({steps})"
if failing:
    verdict += f" at {failing[0]['step']}: {failing[0]['line']}"

lines = [f"{'PASS' if row['pass'] else 'FAIL'}{'?' if row['suspect'] else ''} {row['step']} {row['seconds']}s"
         + ("" if row["pass"] else f" — {row['line']}") for row in rows]
with open(log, "w", encoding="utf-8") as handle:
    handle.write("\n".join(lines + [verdict]) + "\n")

print("\n".join(lines + [verdict]), file=sys.stderr if as_json == "1" else sys.stdout)
if as_json == "1":
    print(json.dumps({"code": code, "pass": not failing, "steps": rows}))
sys.exit(1 if failing else 0)
PY
    rm -f "$out" "$results"
    return $verdict_rc
}

command_name="${1:-help}"
shift || true

case "$command_name" in
    artisan)
        run_core php artisan "$@"
        ;;
    install)
        # --dry-run prints the plan; data and status files stay untouched.
        run_core php artisan ogamex:module:install AI "$@"
        ;;
    uninstall)
        # Data is kept unless --drop-data is given.
        run_core php artisan ogamex:module:uninstall AI "$@"
        ;;
    doctor)
        # Exits non-zero on a blocking wiring problem.
        run_core php artisan ogamex:module:doctor AI "$@"
        ;;
    enable)
        # Status-file toggle only; use `install` when the module was never installed.
        run_core php artisan module:enable AI
        ;;
    disable)
        # Status-file toggle only; use `uninstall` to also refresh caches and workers.
        run_core php artisan module:disable AI
        ;;
    test)
        reap_stale_test_sessions
        # shellcheck disable=SC2046
        with_test_lane run_core $(pest_runner) --testsuite=Modules --filter=AI $(pest_flags) "$@"
        ;;
    test-all)
        reap_stale_test_sessions
        # shellcheck disable=SC2046
        with_test_lane run_core $(pest_runner) $(pest_flags) "$@"
        ;;
    quality)
        # The over-engineering gate runs first: a slice that fails Gate 2 is fixed before
        # any formatter or analyser spends time on it.
        run_core php Modules/AI/scripts/gate-2-review.php
        run_core composer run rector
        run_core composer run cs
        run_core composer run stan
        reap_stale_test_sessions
        # shellcheck disable=SC2046
        with_test_lane run_core $(pest_runner) --testsuite=Modules --filter=AI $(pest_flags)
        ;;
    gate)
        run_core php Modules/AI/scripts/gate-2-review.php
        ;;
    scorecard)
        in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/play-scorecard.php "$@"
        ;;
    situation)
        if [ "${1:-list}" = "list" ]; then
            in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/cohort-scenario.php list
        else
            in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/cohort-scenario.php run "$1" --confirm --cleanup "${@:2}"
        fi
        ;;
    prove)
        prove_row "${1:?usage: prove CODE [--json]}" "${2:-}"
        ;;
    economy)
        in_universe "${PROVE_UNIVERSE:-grand}" php artisan tinker --execute="require '/var/www/Modules/AI/scripts/economy-explain.php'; foreach (explain_economy(${1:?usage: economy PLAYER_ID}) as \$line) { echo \$line, PHP_EOL; }"
        ;;
    pulse)
        in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/live-pulse.php "${1:-15}" "${@:2}"
        ;;
    account)
        in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/live-account.php "${1:?usage: account PLAYER_ID [MINUTES]}" "${2:-60}"
        ;;
    why)
        in_universe "${PROVE_UNIVERSE:-grand}" php Modules/AI/scripts/live-why.php "${1:?usage: why PLAYER_ID}"
        ;;
    stories)
        python3 "$MODULE_ROOT/scripts/stories.py" "$@"
        ;;
    test-one)
        with_test_lane run_core ./vendor/bin/pest --testsuite=Modules --filter="${1:?usage: test-one TestName}"
        ;;
    reap)
        reap_stale_test_sessions
        ;;
    coverage)
        # Coverage is the one serial run: Laravel's parallel runner cannot merge PCOV
        # coverage across workers, and PCOV cannot instrument opcodes that the CLI
        # opcode cache interned before it was enabled. The report is then reduced to
        # this module's own source, which is the scope its 100% gate applies to. It runs
        # in the gate's own database so a live pilot cannot decide the result.
        export AI_DB_OVERRIDE="$COVERAGE_DATABASE"
        reap_stale_test_sessions
        prepare_coverage_database
        run_core timeout -k 5 "${COVERAGE_TIMEOUT:-600}" php -d opcache.enable_cli=0 -d pcov.enabled=1 ./vendor/bin/pest --testsuite=Modules --filter=AI --bail --coverage-clover=/tmp/ogamex-ai-coverage.xml
        run_core php Modules/AI/scripts/coverage-summary.php /tmp/ogamex-ai-coverage.xml
        ;;
    e2e-lifecycle)
        # The host trial drives Docker itself, so it always runs on the host, never
        # through OGAMEX_RUNNER.
        (cd "$OGAMEX_ROOT" && MODULE=AI bash scripts/e2e-module-install-trial.sh)
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command [${command_name}]." >&2
        echo >&2
        usage >&2

        exit 2
        ;;
esac
