#!/usr/bin/env bash

set -euo pipefail

MODULE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OGAMEX_ROOT="${OGAMEX_ROOT:-$(cd "$MODULE_ROOT/../.." 2>/dev/null && pwd || true)}"

if [[ -z "$OGAMEX_ROOT" || ! -f "$OGAMEX_ROOT/artisan" ]]; then
    echo "OGameX root not found. Set OGAMEX_ROOT to the OGameX checkout." >&2
    exit 1
fi

run_core() {
    case "${OGAMEX_RUNNER:-host}" in
        host)
            (cd "$OGAMEX_ROOT" && "$@")
            ;;
        local-docker-dev)
            # local-docker-dev is already running the application. Execute in
            # that service rather than creating a one-off container from the
            # default Compose stack.
            (cd "$OGAMEX_ROOT/local-docker-dev" && docker compose exec -T ogamex-app "$@")
            ;;
        *)
            echo "Unknown OGAMEX_RUNNER '${OGAMEX_RUNNER}'. Use 'host' or 'local-docker-dev'." >&2
            exit 1
            ;;
    esac
}

# Tests always run in parallel: every worker owns its own database clone (see the
# host's ParallelTestSchemaServiceProvider), so there is no serial mode. A serial
# run wastes the whole session. Pin the worker count with PARALLEL_PROCESSES=<n>.
pest_flags() {
    if [[ -n "${PARALLEL_PROCESSES:-}" ]]; then
        printf '%s' "--parallel --bail --processes=${PARALLEL_PROCESSES}"
        return
    fi

    printf '%s' "--parallel --bail"
}

command_name="${1:-help}"
shift || true

case "$command_name" in
    artisan)
        run_core php artisan "$@"
        ;;
    install)
        # Host lifecycle command: verify wiring, migrate, run the install hook, enable,
        # refresh caches and restart the workers. --dry-run prints the plan first.
        run_core php artisan ogamex:module:install AI "$@"
        ;;
    uninstall)
        # Host lifecycle command. Data is kept unless --drop-data is given.
        run_core php artisan ogamex:module:uninstall AI "$@"
        ;;
    doctor)
        # Read-only diagnosis of the queue/container/Redis wiring.
        run_core php artisan ogamex:module:doctor AI "$@"
        ;;
    enable)
        # Raw toggle: flips only the status file. Use `install` when the module was
        # never installed, so its migrations, hook and the caches are handled too.
        run_core php artisan module:enable AI
        ;;
    disable)
        # Raw toggle: see `enable`. Use `uninstall` to also refresh caches and workers.
        run_core php artisan module:disable AI
        ;;
    test)
        # shellcheck disable=SC2046
        run_core ./vendor/bin/pest --testsuite=Modules --filter=AI $(pest_flags) "$@"
        ;;
    test-all)
        # shellcheck disable=SC2046
        run_core ./vendor/bin/pest $(pest_flags) "$@"
        ;;
    e2e-lifecycle)
        # Host trial for the whole module life: the module is moved out of Modules/,
        # installed for real, picked up by supervisord and Horizon, and uninstalled
        # again, with the tracked status file restored afterwards. It drives Docker
        # itself, so it always runs on the host, not through OGAMEX_RUNNER.
        (cd "$OGAMEX_ROOT" && MODULE=AI bash scripts/e2e-module-install-trial.sh)
        ;;
    quality)
        run_core composer run rector
        run_core composer run cs
        run_core composer run stan
        # shellcheck disable=SC2046
        run_core ./vendor/bin/pest --testsuite=Modules --filter=AI $(pest_flags)
        ;;
    coverage)
        # Coverage is the one serial run: Laravel's parallel runner cannot merge PCOV
        # coverage across ParaTest workers (the worker coverage files never appear).
        # The CLI opcode cache is off because PCOV cannot instrument opcodes that
        # opcache interned before it was enabled. The report is then reduced to this
        # module's own source, which is the scope its 100% gate applies to.
        run_core php -d opcache.enable_cli=0 -d pcov.enabled=1 ./vendor/bin/pest --testsuite=Modules --filter=AI --bail --coverage-clover=/tmp/ogamex-ai-coverage.xml
        run_core php Modules/AI/scripts/coverage-summary.php /tmp/ogamex-ai-coverage.xml
        ;;
    help|*)
        echo "Usage: bash scripts/ogamex {artisan|install|uninstall|doctor|enable|disable|test|test-all|quality|coverage|e2e-lifecycle} [args...]"
        echo ""
        echo "Lifecycle (host commands, run from the module checkout):"
        echo "  install [--dry-run]                     migrate, run the install hook, enable, refresh caches"
        echo "  uninstall [--drop-data] [--dry-run]     uninstall hook, optional data drop, disable, refresh caches"
        echo "  doctor                                  read-only wiring report for this module"
        echo "  enable / disable                        raw status-file toggles only"
        echo "  e2e-lifecycle                           live host trial: absent, install, pickup, uninstall"
        echo ""
        echo "Tests always run in parallel with --bail; coverage is the one serial run."
        echo "  PARALLEL_PROCESSES=<n>    pin the worker count"
        exit 0
        ;;
esac
