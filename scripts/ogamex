#!/usr/bin/env bash
#
# The AI module's task runner: one short command for every module task, run from the
# module checkout. Commands execute on the host by default; OGAMEX_RUNNER=local-docker-dev
# runs them inside the application container instead.
set -euo pipefail

MODULE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OGAMEX_ROOT="${OGAMEX_ROOT:-$(cd "$MODULE_ROOT/../.." 2>/dev/null && pwd || true)}"

if [ -z "$OGAMEX_ROOT" ] || [ ! -f "$OGAMEX_ROOT/artisan" ]; then
    echo "OGameX root not found. Set OGAMEX_ROOT to the OGameX checkout." >&2

    exit 1
fi

run_core() {
    # A command that must not share a database with the running application passes one through
    # AI_DB_OVERRIDE; every other command uses the container's own configuration.
    db_pair=()
    db_flag=()
    if [ -n "${AI_DB_OVERRIDE:-}" ]; then
        db_pair=("DB_DATABASE=${AI_DB_OVERRIDE}")
        db_flag=(-e "DB_DATABASE=${AI_DB_OVERRIDE}")
    fi

    case "${OGAMEX_RUNNER:-host}" in
        host)
            (cd "$OGAMEX_ROOT" && env "${db_pair[@]}" "$@")
            ;;
        local-docker-dev)
            # PAO formats output for an agent and decides that from the environment. The
            # editor sets an agent marker in this shell, but `docker compose exec` starts the
            # container with the service environment only, so the marker has to be passed
            # through explicitly; the PAO switches ride along for the operator.
            pao_env=()
            for name in AI_AGENT PAO_FORCE PAO_DISABLE; do
                if [ -n "${!name:-}" ]; then
                    pao_env+=(-e "$name=${!name}")
                fi
            done

            # local-docker-dev already runs the application, so commands execute in that
            # container instead of a one-off container from the default stack.
            (cd "$OGAMEX_ROOT/local-docker-dev" && docker compose exec -T "${pao_env[@]}" "${db_flag[@]}" ogamex-app "$@")
            ;;
        *)
            echo "Unknown OGAMEX_RUNNER '${OGAMEX_RUNNER}'. Use 'host' or 'local-docker-dev'." >&2

            exit 1
            ;;
    esac
}

# Tests always run in parallel: every worker owns its database clone and its compiled
# caches, so bailing early costs nothing while a serial run wastes the session.
#
# The worker count is pinned rather than auto-detected. Laravel keys each clone
# database off the worker token, so an auto-detected count on a many-core host creates
# one full schema per core: dozens of databases, a persistent connection per clone, and
# schema DDL that blocks behind those idle connections. A bounded count keeps the clone
# set small and lets the same clones be reused across runs instead of accumulating.
pest_flags() {
    printf '%s' "--parallel --bail --processes=${PARALLEL_PROCESSES:-4}"
}

# The timeout runs *inside* the container, not around the `docker compose exec` client.
#
# A docker exec client does not forward a signal to the process it started, so timing the
# client out or cancelling it leaves the test workers running: they keep their database
# transactions and row locks, and every later run then fails on a one second lock wait
# timeout. Bounding the run where the workers actually live means a run cannot outlive its
# own budget. Hitting this cap means a hang, not slowness.
pest_runner() {
    printf 'timeout -k 5 %s ./vendor/bin/pest' "${TEST_TIMEOUT:-120}"
}

# Clears locks left behind by an earlier killed run before starting a new one, so a stale
# session is self-healing instead of a manual database rescue.
reap_stale_test_sessions() {
    run_core php Modules/AI/scripts/reap-test-sessions.php
}

# The database the serial gate owns, created on first use and kept current afterwards.
#
# The gate is the one run that cannot have Laravel's per-worker database clones, and its test cases
# roll back instead of starting from a fresh schema. Any row another process committed while it runs
# is therefore visible to it: a pilot account finishing a building in the same database is enough to
# fail a test that counts rows, and a failing gate then looks like a code defect that is not there.
# Sharing a database with the running application is not a test environment, so the gate takes one
# of its own and no longer depends on what else is running. The name has to read as a test database:
# the stale-session reaper only ever touches one of those.
COVERAGE_DATABASE="${AI_COVERAGE_DATABASE:-ogamex-test-ai-coverage}"

prepare_coverage_database() {
    # Creating the database needs a connection without one selected, so it is done with a raw
    # client rather than through the application, which could not connect to a missing database.
    run_core php -r '
$pdo = new PDO(
    sprintf("mysql:host=%s;port=%s", getenv("DB_HOST"), getenv("DB_PORT") ?: "3306"),
    (string) getenv("DB_USERNAME"),
    (string) getenv("DB_PASSWORD"),
);
$pdo->exec(sprintf(
    "CREATE DATABASE IF NOT EXISTS `%s` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci",
    getenv("DB_DATABASE"),
));
'
    run_core php artisan migrate --force --no-interaction
}

usage() {
    cat <<'TEXT'
Usage: bash scripts/ogamex <command> [args...]

Lifecycle (host commands; the module never reimplements them):
  install [--dry-run]                   verify, migrate, run the install hook, enable, refresh
  uninstall [--drop-data] [--dry-run]   uninstall hook, optional data drop, disable, refresh
  doctor                                read-only queue/container/Redis wiring report
  enable | disable                      raw status-file toggles only
  e2e-lifecycle                         live host trial: absent, install, pickup, uninstall

Checks:
  artisan <args...>                     run any artisan command in the host
  test                                  Pest for this module, parallel with --bail
  test-all                              the whole OGameX suite, parallel with --bail
  quality                               Gate 2 review, Rector, Pint, PHPStan, then this module's tests
  gate                                  the over-engineering gate (Gate 2), deterministic half
  coverage                              the one serial run: PCOV coverage of Modules/AI/app
  reap                                  release locks left by a killed test run

Environment:
  OGAMEX_ROOT          OGameX checkout (default: two levels above this script)
  OGAMEX_RUNNER        host (default) or local-docker-dev
  PARALLEL_PROCESSES   pin the number of test workers
  TEST_TIMEOUT         seconds before a test run is killed in-container (default: 120)
  COVERAGE_TIMEOUT     seconds before the serial coverage run is killed (default: 600)
  AI_COVERAGE_DATABASE database the serial coverage gate owns (default: ogamex-test-ai-coverage)
TEXT
}

command_name="${1:-help}"
shift || true

case "$command_name" in
    artisan)
        run_core php artisan "$@"
        ;;
    install)
        # --dry-run prints the plan; data and status files stay untouched.
        run_core php artisan ogamex:module:install AI "$@"
        ;;
    uninstall)
        # Data is kept unless --drop-data is given.
        run_core php artisan ogamex:module:uninstall AI "$@"
        ;;
    doctor)
        # Exits non-zero on a blocking wiring problem.
        run_core php artisan ogamex:module:doctor AI "$@"
        ;;
    enable)
        # Status-file toggle only; use `install` when the module was never installed.
        run_core php artisan module:enable AI
        ;;
    disable)
        # Status-file toggle only; use `uninstall` to also refresh caches and workers.
        run_core php artisan module:disable AI
        ;;
    test)
        reap_stale_test_sessions
        # shellcheck disable=SC2046
        run_core $(pest_runner) --testsuite=Modules --filter=AI $(pest_flags) "$@"
        ;;
    test-all)
        reap_stale_test_sessions
        # shellcheck disable=SC2046
        run_core $(pest_runner) $(pest_flags) "$@"
        ;;
    quality)
        # The over-engineering gate runs first: a slice that fails Gate 2 is fixed before
        # any formatter or analyser spends time on it.
        run_core php Modules/AI/scripts/gate-2-review.php
        run_core composer run rector
        run_core composer run cs
        run_core composer run stan
        reap_stale_test_sessions
        # shellcheck disable=SC2046
        run_core $(pest_runner) --testsuite=Modules --filter=AI $(pest_flags)
        ;;
    gate)
        run_core php Modules/AI/scripts/gate-2-review.php
        ;;
    reap)
        reap_stale_test_sessions
        ;;
    coverage)
        # Coverage is the one serial run: Laravel's parallel runner cannot merge PCOV
        # coverage across workers, and PCOV cannot instrument opcodes that the CLI
        # opcode cache interned before it was enabled. The report is then reduced to
        # this module's own source, which is the scope its 100% gate applies to. It runs
        # in the gate's own database so a live pilot cannot decide the result.
        export AI_DB_OVERRIDE="$COVERAGE_DATABASE"
        reap_stale_test_sessions
        prepare_coverage_database
        run_core timeout -k 5 "${COVERAGE_TIMEOUT:-600}" php -d opcache.enable_cli=0 -d pcov.enabled=1 ./vendor/bin/pest --testsuite=Modules --filter=AI --bail --coverage-clover=/tmp/ogamex-ai-coverage.xml
        run_core php Modules/AI/scripts/coverage-summary.php /tmp/ogamex-ai-coverage.xml
        ;;
    e2e-lifecycle)
        # The host trial drives Docker itself, so it always runs on the host, never
        # through OGAMEX_RUNNER.
        (cd "$OGAMEX_ROOT" && MODULE=AI bash scripts/e2e-module-install-trial.sh)
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command [${command_name}]." >&2
        echo >&2
        usage >&2

        exit 2
        ;;
esac
