#!/usr/bin/env bash

set -euo pipefail

MODULE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OGAMEX_ROOT="${OGAMEX_ROOT:-$(cd "$MODULE_ROOT/../.." 2>/dev/null && pwd || true)}"

if [[ -z "$OGAMEX_ROOT" || ! -f "$OGAMEX_ROOT/artisan" ]]; then
    echo "OGameX root not found. Set OGAMEX_ROOT to the OGameX checkout." >&2
    exit 1
fi

run_core() {
    if [[ "${OGAMEX_RUNNER:-host}" == "docker" ]]; then
        (cd "$OGAMEX_ROOT" && docker compose run --rm --no-deps ogamex-app "$@")
    else
        (cd "$OGAMEX_ROOT" && "$@")
    fi
}

command_name="${1:-help}"
shift || true

case "$command_name" in
    artisan)
        run_core php artisan "$@"
        ;;
    enable)
        run_core php artisan module:enable AI
        ;;
    disable)
        run_core php artisan module:disable AI
        ;;
    test)
        run_core ./vendor/bin/pest --testsuite=Modules --filter=AI "$@"
        ;;
    test-all)
        run_core ./vendor/bin/pest "$@"
        ;;
    quality)
        run_core composer run rector
        run_core composer run cs
        run_core composer run stan
        run_core ./vendor/bin/pest --testsuite=Modules --filter=AI
        ;;
    help|*)
        echo "Usage: bash scripts/ogamex {artisan|enable|disable|test|test-all|quality} [args...]"
        exit 0
        ;;
esac

