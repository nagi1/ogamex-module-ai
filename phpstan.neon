includes:
    - ../../vendor/larastan/larastan/extension.neon
    # Errors that predate CI (8 Nov 2026); new code may not add to it, and a fixed entry is removed from it.
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - app
    ignoreErrors:
        # Which treaty store answers depends on whether the Empire module is enabled where the analysis runs.
        -
            message: '#^Instanceof between Modules\\AI\\Infrastructure\\Diplomacy\\\w+ and Modules\\AI\\Infrastructure\\Diplomacy\\EmpireAllianceTreaties will always evaluate to (true|false)\.$#'
            path: app/Actions/CheckSocialIntegrityAction.php
            reportUnmatched: false

services:
    -
        class: Modules\AI\Rules\DisallowDirectInstantiationRule
        tags:
            - phpstan.rules.rule
    -
        class: Modules\AI\Rules\DisallowElseRule
        tags:
            - phpstan.rules.rule
