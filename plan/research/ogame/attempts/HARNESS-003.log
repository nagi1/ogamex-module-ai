#!/usr/bin/env bash
#
# Container entrypoint for the OGameX application.
#
# Laravel decides which passes are due by matching each schedule's cron
# expression against the wall-clock minute. A loop that sleeps a fixed 60
# seconds drifts later by however long the previous `schedule:run` took; once
# the drift crosses a minute boundary the loop is looking at the clock partway
# through every minute, so the everyMinute, everyTenMinutes and hourly passes
# are never due at the moment it looks and silently stop firing. Sleeping to the
# top of the next minute keeps every iteration locked to the boundaries the cron
# expressions are evaluated against.
#
# Usage:
#   entrypoint.sh                  # run the scheduler loop in the foreground
#   entrypoint.sh php-fpm --foo    # exec the given command instead

set -euo pipefail

APP_DIR="${APP_DIR:-/var/www/html}"
PHP_BIN="${PHP_BIN:-php}"

log() {
    printf '[entrypoint] %s\n' "$*"
}

